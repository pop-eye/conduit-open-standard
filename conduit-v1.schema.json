    "VideoResolution": {
      "type": "object",
      "description": "Video resolution and frame rate specification.",
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            1920,
            3840,
            7680
          ]
        },
        "height_px": {
          "type": "integer",
          "minimum": 1,
          "examples": [
            1080,
            2160,
            4320
          ]
        },
        "fps": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ],
          "description": "Frame rate(s) in Hz. Array if multiple are supported.",
          "examples": [
            60,
            [
              23.98,
              24,
              25,
              29.97,
              30,
              50,
              59.94,
              60
            ]
          ]
        },
        "colour_space": {
          "type": "string",
          "enum": [
            "RGB",
            "YCbCr-444",
            "YCbCr-422",
            "YCbCr-420"
          ],
          "description": "Colour subsampling format at maximum resolution."
        },
        "bit_depth": {
          "type": "integer",
          "description": "Colour bit depth per channel at maximum resolution.",
          "examples": [
            8,
            10,
            12
          ]
        },
        "hdr": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "HDR10",
              "HDR10+",
              "HLG",
              "Dolby-Vision",
              "HDR-Vivid"
            ]
          },
          "description": "Supported HDR formats at this port."
        }
      },
      "additionalProperties": false
    },
    "Protocol": {
      "type": "object",
      "description": "An application-layer protocol supported by this device.",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Protocol name.",
          "examples": [
            "Art-Net 4",
            "sACN E1.31",
            "Dante",
            "AES67",
            "NDI 5",
            "OSC",
            "RDM",
            "MIDI 2.0"
          ]
        },
        "version": {
          "type": "string",
          "description": "Protocol version supported.",
          "examples": [
            "4",
            "2.0",
            "E1.31-2016"
          ]
        },
        "transport": {
          "type": "string",
          "enum": [
            "udp",
            "tcp",
            "udp-tcp",
            "serial",
            "usb",
            "bluetooth",
            "proprietary"
          ],
          "description": "Underlying transport layer."
        },
        "port_number": {
          "type": "integer",
          "description": "UDP/TCP port number, if applicable.",
          "minimum": 1,
          "maximum": 65535,
          "examples": [
            6454,
            5568,
            8000
          ]
        },
        "universe_count": {
          "type": "integer",
          "description": "For DMX-over-IP protocols: number of universes supported.",
          "minimum": 1,
          "examples": [
            1,
            4,
            8,
            32
          ]
        },
        "channel_count": {
          "type": "integer",
          "description": "For audio protocols: total routable channel count.",
          "minimum": 1,
          "examples": [
            64,
            128,
            512
          ]
        },
        "notes": {
          "type": "string",
          "description": "Any important notes about this protocol implementation — e.g. known limitations, required configuration, AES67 compatibility mode."
        }
      }
    },
    "ControlCapabilities": {
      "type": "object",
      "description": "Control and integration capabilities of this device.",
      "additionalProperties": false,
      "properties": {
        "web_ui": {
          "type": "boolean",
          "description": "Whether the device has a built-in HTTP web interface for configuration."
        },
        "rest_api": {
          "type": "boolean",
          "description": "Whether the device exposes a REST API."
        },
        "snmp": {
          "type": "boolean",
          "description": "Whether the device supports SNMP monitoring."
        },
        "dante_controller": {
          "type": "boolean",
          "description": "Whether the device is configurable via Dante Controller."
        },
        "rdm_addressable": {
          "type": "boolean",
          "description": "Whether the device can be addressed and configured via RDM."
        },
        "nfc": {
          "type": "boolean",
          "description": "Whether the device supports NFC for configuration or pairing."
        },
        "custom_commands": {
          "type": "array",
          "description": "RS-232, RS-485, or TCP/IP command strings for common control operations.",
          "items": {
            "type": "object",
            "required": [
              "action",
              "command"
            ],
            "properties": {
              "action": {
                "type": "string",
                "examples": [
                  "power_on",
                  "power_off",
                  "input_select_hdmi1"
                ]
              },
              "command": {
                "type": "string",
                "description": "The raw command string, hex-encoded if binary.",
                "examples": [
                  "\\x02 PON\\x03",
                  "PWR ON\\r\\n"
                ]
              },
              "transport": {
                "type": "string",
                "enum": [
                  "rs232",
                  "rs485",
                  "tcp",
                  "udp"
                ]
              },
              "baud_rate": {
                "type": "integer",
                "examples": [
                  9600,
                  19200,
                  115200
                ]
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "ProfileMeta": {
      "type": "object",
      "description": "Metadata about this profile document — who created it, when, and its verification status.",
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date",
          "description": "ISO 8601 date this profile was first created.",
          "examples": [
            "2026-03-29"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date",
          "description": "ISO 8601 date this profile was last updated.",
          "examples": [
            "2026-03-29"
          ]
        },
        "created_by": {
          "type": "string",
          "description": "GitHub username, organisation, or Verified Manufacturer identifier of the profile author."
        },
        "source": {
          "type": "string",
          "enum": [
            "manufacturer",
            "community",
            "automated"
          ],
          "description": "Origin of this profile. 'manufacturer' = submitted by the device manufacturer. 'community' = user-contributed. 'automated' = extracted via datasheet scraping pipeline."
        },
        "verified": {
          "type": "boolean",
          "description": "Whether this profile has been verified against physical hardware or official documentation by a trusted reviewer."
        },
        "license": {
          "type": "string",
          "description": "License under which this profile is contributed.",
          "enum": [

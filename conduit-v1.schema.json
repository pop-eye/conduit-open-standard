    },
    "ConnectorType": {
      "type": "string",
      "description": "Physical connector type. Parsers encountering unknown values MUST treat them as opaque strings and must not error.",
      "enum": [
        "xlr-3f",
        "xlr-3m",
        "xlr-5f",
        "xlr-5m",
        "trs-6.35mm",
        "ts-6.35mm",
        "trs-3.5mm",
        "ts-3.5mm",
        "trrs-3.5mm",
        "rca",
        "bnc",
        "speakon-nl2",
        "speakon-nl4",
        "speakon-nl8",
        "db25",
        "db9",
        "db15",
        "hdmi-a",
        "hdmi-c",

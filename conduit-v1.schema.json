        "network/zwave",
        "network/thread",
        "network/matter",
        "power/mains/ac/uk",
        "power/mains/ac/eu",
        "power/mains/ac/us",
        "power/mains/ac/universal",
        "power/mains/ac/three-phase",
        "power/dc",
        "power/dc/5v",

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://conduit-standard.org/schema/conduit-v1.schema.json",
  "title": "Conduit Open Standard — Device Profile",
  "description": "A universal, machine-readable description of any connected hardware device: its ports, signal types, protocols, power requirements, and physical properties. Version conduit/v1-draft.",
  "type": "object",
  "required": [
    "schema_version",
    "manufacturer",
    "model",
    "category",
    "ports"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Versioned namespace identifier for this schema. Parsers MUST ignore unknown fields to maintain forward compatibility.",
      "enum": [
        "conduit/v1-draft",
        "conduit/v1"
      ],
      "examples": [
        "conduit/v1-draft"
      ]
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer name as it appears on the device or official documentation.",
      "minLength": 1,
      "examples": [
        "Christie Digital",
        "Blackmagic Design",
        "Yamaha",
        "Robe Lighting",
        "Audinate"
      ]
    },
    "model": {
      "type": "string",
      "description": "Full model name or number as it appears on the device or official documentation.",
      "minLength": 1,
      "examples": [
        "DWU1400-GS",
        "ATEM Mini Pro",
        "QL5",
        "ESPRITE",
        "AVIO USB-C"
      ]
    },
    "model_variant": {
      "type": "string",
      "description": "Optional variant, revision, or regional suffix that distinguishes this profile from the base model.",
      "examples": [
        "EU",
        "Rev B",
        "4K",
        "IP"
      ]
    },
    "category": {
      "$ref": "#/$defs/DeviceCategory"
    },
    "subcategory": {
      "type": "string",
      "description": "Optional freeform subcategory for more granular classification within the category.",
      "examples": [
        "LED wash",
        "media server",
        "broadcast camera",
        "stagebox"
      ]
    },
    "description": {
      "type": "string",
      "description": "Short human-readable description of the device and its primary function.",
      "examples": [
        "Single-chip DLP laser projector, WUXGA, 14,000 lumens"
      ]
    },
    "form_factor": {
      "$ref": "#/$defs/FormFactor"
    },
    "dimensions": {
      "$ref": "#/$defs/Dimensions"
    },
    "weight_kg": {
      "type": "number",
      "description": "Weight in kilograms.",
      "minimum": 0,
      "examples": [
        12.5,
        0.85
      ]
    },
    "rack_units": {
      "type": "integer",
      "description": "Rack height in U (rack units), if the device is rack-mountable.",
      "minimum": 1,
      "maximum": 48,
      "examples": [
        1,
        2,
        4
      ]
    },
    "power": {
      "$ref": "#/$defs/PowerRequirements"
    },
    "ports": {
      "type": "array",
      "description": "All physical ports on this device. Each port has a signal type, connector type, and direction.",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Port"
      }
    },
    "protocols": {
      "type": "array",
      "description": "Application-layer protocols supported by this device, beyond what is implied by port signal types.",
      "items": {
        "$ref": "#/$defs/Protocol"
      }
    },
    "control": {
      "$ref": "#/$defs/ControlCapabilities"
    },
    "firmware": {
      "type": "string",
      "description": "Firmware or software version this profile was created against.",
      "examples": [
        "3.4.1",
        "2024.1.0"
      ]
    },
    "datasheet_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the official manufacturer datasheet this profile was derived from."
    },
    "manual_url": {
      "type": "string",
      "format": "uri",
      "description": "URL to the official user manual."
    },
    "gdtf_fixture_type": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional reference to a GDTF fixture type UUID."
    },
    "mvr_class": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "MVR class name for this device, if applicable."
    },
    "tags": {
      "type": "array",
      "description": "Freeform tags for search and filtering.",
      "items": {
        "type": "string"
      },
      "examples": [
        [
          "touring",
          "IP-rated",
          "IP65",
          "outdoor"
        ]
      ]
    },
    "notes": {
      "type": "string",
      "description": "Freeform notes about this device profile — known issues, quirks, or important caveats."
    },
    "profile_meta": {
      "$ref": "#/$defs/ProfileMeta"
    },
    "extensions": {
      "type": "object",
      "description": "Domain-specific extension data. Keys should be namespaced (e.g. 'conduit:lighting', 'conduit:video'). Parsers MUST ignore unknown extension keys.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "DeviceCategory": {
      "type": "string",
      "description": "Primary category classifying the device's function.",
      "enum": [
        "projector",
        "display",
        "led-processor",
        "led-fixture",
        "media-server",
        "video-switcher",
        "video-scaler",
        "video-converter",
        "video-matrix",
        "video-capture",
        "video-encoder",
        "video-decoder",
        "camera",
        "lighting-fixture",
        "lighting-console",
        "lighting-dimmer",
        "lighting-node",
        "lighting-gateway",
        "audio-console",
        "audio-interface",
        "audio-amplifier",
        "audio-processor",
        "audio-stagebox",
        "audio-loudspeaker",
        "audio-monitor",
        "audio-gateway",
        "network-switch",
        "network-router",
        "network-gateway",
        "media-player",
        "show-controller",
        "control-system",
        "intercom",
        "power-distribution",
        "ups",
        "computer",
        "other"
      ]
    },
    "FormFactor": {
      "type": "string",
      "description": "Physical form factor of the device.",
      "enum": [
        "rackmount",
        "desktop",
        "floor-standing",
        "ceiling-mount",
        "truss-mount",
        "wall-mount",
        "handheld",
        "wearable",
        "blade",
        "modular",
        "portable",
        "installed",
        "other"
      ]
    },
    "Dimensions": {
      "type": "object",
      "description": "Physical dimensions in millimetres.",
      "properties": {
        "width_mm": {
          "type": "number",
          "minimum": 0
        },
        "height_mm": {
          "type": "number",
          "minimum": 0
        },
        "depth_mm": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "PowerRequirements": {
      "type": "object",
      "description": "Power supply and consumption requirements for this device.",
      "properties": {
        "voltage_v": {
          "oneOf": [
            {
              "type": "number",
              "description": "Single nominal voltage (e.g. 230)"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "Range or dual-voltage [min, max] (e.g. [100, 240])"
            }
          ]
        },
        "frequency_hz": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ],
          "description": "AC frequency in Hz (e.g. 50, 60, or [50, 60] for universal)."
        },
        "phases": {
          "type": "integer",
          "enum": [
            1,
            3
          ],
          "description": "Number of AC phases: 1 (single-phase) or 3 (three-phase)."
        },
        "max_wattage": {
          "type": "number",
          "description": "Maximum power consumption in watts.",
          "minimum": 0
        },
        "typical_wattage": {
          "type": "number",
          "description": "Typical operating power consumption in watts.",
          "minimum": 0
        },
        "standby_wattage": {
          "type": "number",
          "description": "Power draw in standby mode, in watts.",
          "minimum": 0
        },
        "inrush_current_a": {
          "type": "number",
          "description": "Peak inrush current on power-on, in amperes. Important for circuit breaker sizing.",
          "minimum": 0
        },
        "connector_type": {
          "$ref": "#/$defs/ConnectorType"
        },
        "psu_type": {
          "type": "string",
          "enum": [
            "internal",
            "external-brick",
            "external-rackmount",
            "poe",
            "poe-plus",
            "poe-plus-plus",
            "usb-pd",
            "hdbaset-poh",
            "dc-barrel"
          ],
          "description": "Type of power supply arrangement."
        },
        "redundant_psu": {
          "type": "boolean",
          "description": "Whether the device supports or ships with redundant PSU."
        }
      },
      "additionalProperties": false
    },
    "Port": {
      "type": "object",
      "description": "A single physical port on the device.",
      "required": [
        "id",
        "label",
        "signal_type",
        "connector_type",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this port within the device profile. Used for referencing in compatibility rules and signal graphs.",
          "pattern": "^[a-z0-9_-]+$",
          "examples": [
            "hdmi_out_1",
            "dmx_in_a",
            "dante_primary"
          ]
        },
        "label": {
          "type": "string",
          "description": "Human-readable label as it appears (or should appear) on the device panel.",
          "examples": [
            "HDMI OUT 1",
            "DMX A",
            "DANTE PRIMARY"
          ]
        },
        "signal_type": {
          "$ref": "#/$defs/SignalType"
        },
        "connector_type": {
          "$ref": "#/$defs/ConnectorType"
        },
        "direction": {
          "type": "string",
          "enum": [
            "in",
            "out",
            "bidirectional",
            "power-in",
            "power-out"
          ],
          "description": "Signal flow direction relative to this device. 'bidirectional' for ports that can operate in both directions (e.g. MIDI thru, Ethernet). 'power-in' and 'power-out' for power ports."
        },
        "count": {
          "type": "integer",
          "description": "Number of identical ports sharing this definition (e.g. 8x DMX universe outputs). If omitted, assumed to be 1.",
          "minimum": 1,
          "default": 1
        },
        "panel_side": {
          "type": "string",
          "enum": [
            "front",
            "rear",
            "left",
            "right",
            "top",
            "bottom",
            "internal"
          ],
          "description": "Which face of the device this port is located on."
        },
        "panel_position": {
          "type": "integer",
          "description": "Left-to-right or top-to-bottom index of this port on its panel face, starting at 1.",
          "minimum": 1
        },
        "universe": {
          "type": "integer",
          "description": "For DMX, Art-Net, or sACN ports: the universe number assigned to this port.",
          "minimum": 0
        },
        "channel_count": {
          "type": "integer",
          "description": "For audio ports: number of audio channels carried on this port.",
          "minimum": 1,
          "examples": [
            2,
            8,
            16,
            56,
            64
          ]
        },
        "sample_rate_hz": {
          "type": "integer",
          "description": "For digital audio ports: supported or fixed sample rate in Hz.",
          "examples": [
            44100,
            48000,
            96000,
            192000
          ]
        },
        "bit_depth": {
          "type": "integer",
          "description": "For digital audio ports: bit depth.",
          "examples": [
            16,
            24,
            32
          ]
        },
        "impedance_ohm": {
          "type": "number",
          "description": "Port impedance in ohms. Critical for SDI (75Ω), AES3 (110Ω), RS-485 (120Ω termination).",
          "examples": [
            75,
            110,
            120,
            600
          ]
        },
        "max_resolution": {
          "$ref": "#/$defs/VideoResolution",
          "description": "For video ports: maximum supported resolution and frame rate."
        },
        "hdcp": {
          "type": "boolean",
          "description": "For video ports: whether HDCP copy protection is supported."
        },
        "poe_class": {
          "type": "string",
          "enum": [
            "0",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8"
          ],
          "description": "For PoE ports: IEEE 802.3 power class. Class 4 = 30W (PoE+), Class 8 = 90W (PoE++)."
        },
        "voltage_v": {
          "type": "number",
          "description": "For DC power ports: voltage in volts.",
          "examples": [
            5,
            12,
            24,
            48
          ]
        },
        "current_a": {
          "type": "number",
          "description": "For DC power ports: maximum current in amperes.",
          "examples": [
            1,
            2,
            4.17
          ]
        },
        "termination": {
          "type": "boolean",
          "description": "For RS-485 / DMX ports: whether this device has a built-in 120Ω termination resistor that can be switched in."
        },
        "loopthrough": {
          "type": "boolean",
          "description": "Whether this port supports passive loop-through (e.g. SDI loop-out, DMX thru) without active processing."
        },
        "passive_loop": {
          "type": "boolean",
          "description": "True if loopthrough is entirely passive (no reclocking or regeneration). False if actively regenerated."
        },
        "notes": {
          "type": "string",
          "description": "Freeform notes specific to this port — known quirks, configuration requirements, or compatibility caveats."
        }
      }
    },
    "SignalType": {
      "type": "string",
      "description": "Hierarchical signal type namespace. Use the most specific subtype available. Parsers encountering unknown values MUST treat them as opaque strings and must not error.",
      "$comment": "Format: domain/protocol[/subtype]. Domain is the top-level signal category. Unknown future subtypes are valid — the enum is a known-good reference set, not an exhaustive list.",
      "enum": [
        "video/hdmi",
        "video/hdmi/1.4",
        "video/hdmi/2.0",
        "video/hdmi/2.1",
        "video/displayport",
        "video/displayport/1.2",
        "video/displayport/1.4",
        "video/displayport/2.1",
        "video/sdi",
        "video/sdi/sd",
        "video/sdi/hd",
        "video/sdi/3g",
        "video/sdi/6g",
        "video/sdi/12g",
        "video/sdi/24g",
        "video/ndi",
        "video/ndi/hx",
        "video/smpte2110",
        "video/smpte2110/20",
        "video/smpte2110/30",
        "video/smpte2110/40",
        "video/hdbaset",
        "video/hdbaset/class-a",
        "video/hdbaset/class-b",
        "video/hdbaset/class-c",
        "video/dvi",

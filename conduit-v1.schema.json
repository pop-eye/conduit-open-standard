        "control/timecode/ptp",
        "control/timecode/aes11",
        "control/wordclock",
        "control/artnet-rdm",
        "control/modbus/rtu",
        "control/modbus/tcp",
        "control/knx",
        "control/bacnet",
        "control/tcp-ip",
        "control/cec",
        "network/ethernet/100m",
        "network/ethernet/1g",
        "network/ethernet/2.5g",
        "network/ethernet/10g",
